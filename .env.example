DATABASE_URL=postgres://casework:casework@localhost:5432/casework
APP_BASE_URL=http://localhost:3000
# Port used by `npm run start:local` (the web app); APP_BASE_URL should match it.
# PORT=3100
AUTH_SESSION_COOKIE_NAME=sicwe_session
AUTH_SESSION_TTL_HOURS=12

# External participant portal sessions.
PARTICIPANT_SESSION_COOKIE_NAME=sicwe_participant_session
PARTICIPANT_SESSION_TTL_HOURS=8
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_BLOCK_MINUTES=15
# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For/X-Real-IP.
AUTH_TRUST_PROXY_HEADERS=false

# One-time local/bootstrap setup. Do not commit real values.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.gov
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ORGANIZATION_NAME=Example Office
# BOOTSTRAP_ORGANIZATION_SLUG=example-office

# Document storage. The local driver is for development or persistent-volume deployments.
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_ROOT=.data/documents
DOCUMENT_MAX_BYTES=26214400
# Aggregate byte ceiling for all public attachments in one form submission.
# Keep below the framework's 64 MB multipart transport ceiling.
PUBLIC_UPLOAD_TOTAL_MAX_BYTES=52428800

# Durable background jobs and recurring deadline processing.
BACKGROUND_JOB_LEASE_SECONDS=60
BACKGROUND_JOB_POLL_MS=1000
BACKGROUND_JOB_BATCH_SIZE=10
BACKGROUND_DEADLINE_SWEEP_SECONDS=60

# Integration API / webhook delivery
API_DEFAULT_RATE_LIMIT_PER_MINUTE=120
# 32-byte AES key encoded as 64 hexadecimal characters; required to create/deliver webhooks.
# WEBHOOK_ENCRYPTION_KEY=

# Protected form compartments.
# 32-byte AES key encoded as 64 hexadecimal characters.
# Required only when a published form actually uses field.protection.
# Keep this value stable for the lifetime of encrypted records; use a secrets manager.
# PROTECTED_DATA_ENCRYPTION_KEY=


# Durable document storage. Local remains the development default.
# Production deployments should use an S3-compatible private bucket unless the
# host provides an independently backed-up durable filesystem shared by web and worker.
# DOCUMENT_S3_ENDPOINT=https://s3.example.com
# DOCUMENT_S3_REGION=us-east-1
# DOCUMENT_S3_BUCKET=secure-case-documents
# DOCUMENT_S3_ACCESS_KEY_ID=
# DOCUMENT_S3_SECRET_ACCESS_KEY=
# DOCUMENT_S3_SESSION_TOKEN=

# Optional production malware-scanner adapter. If MALWARE_SCANNER_URL is unset,
# uploads remain quarantined and document.scan jobs retry/fail rather than
# becoming implicitly clean.
# Scanner contract: POST raw file bytes over HTTPS and return JSON
# {"status":"clean"|"infected"|"failed","details":{...}}.
# MALWARE_SCANNER_URL=https://scanner.example.com/v1/scan
# MALWARE_SCANNER_PROVIDER=approved-scanner
# MALWARE_SCANNER_TOKEN=
MALWARE_SCANNER_TIMEOUT_MS=120000

# Local ClamAV adapter (alternative to MALWARE_SCANNER_URL).
# MALWARE_SCANNER_DRIVER: clamscan | http | none. With `none`, or with nothing
# configured, uploads stay quarantined: nothing is ever assumed clean.
# MALWARE_SCANNER_DRIVER=clamscan
# CLAMSCAN_PATH=clamscan
# Directory holding the signature database (*.cvd, *.cld, *.hdb, *.ndb ...).
# CLAMSCAN_DATABASE_DIR=/var/lib/clamav

# Deployment provisioning API (/api/v1/platform/*). Disabled (404) when unset.
# Value is the SHA-256 hex digest of a random token of at least 32 characters:
#   TOKEN=$(openssl rand -base64 48 | tr -d '\n=+/'); printf %s "$TOKEN" | sha256sum
# PLATFORM_API_TOKEN_SHA256=

# Exact webhook origins that may be private or plain HTTP (comma separated),
# for a downstream application on the same host or private network. Every
# other webhook destination must be public HTTPS.
# WEBHOOK_ALLOWED_PRIVATE_ORIGINS=http://127.0.0.1:8090
